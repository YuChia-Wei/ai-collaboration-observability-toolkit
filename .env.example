# Copy this file to .env before starting the stack.
COMPOSE_PROJECT_NAME=ai-collaboration-observability

# Exact default images. Override only as a reviewed upgrade.
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.158.0
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
LOKI_IMAGE=grafana/loki:3.7.6
TEMPO_IMAGE=grafana/tempo:3.0.2
GRAFANA_IMAGE=grafana/grafana:13.1.3
PHOENIX_IMAGE=arizephoenix/phoenix:version-19.19.0-nonroot
POSTGRES_IMAGE=postgres:18.4-alpine3.24

OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
PHOENIX_PORT=6006

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

PHOENIX_POSTGRES_USER=phoenix
PHOENIX_POSTGRES_PASSWORD=change-me-local-only
PHOENIX_POSTGRES_DB=phoenix

PROMETHEUS_RETENTION=14d
