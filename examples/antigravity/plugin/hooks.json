{
  "ai-observability-model-lifecycle": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python scripts/emit_otel.py pre-invocation",
        "timeout": 3
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python scripts/emit_otel.py post-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/emit_otel.py stop",
        "timeout": 5
      }
    ]
  },
  "ai-observability-tool-outcomes": {
    "PostToolUse": [
      {
        "matcher": "view_file|write_to_file|replace_file_content|multi_replace_file_content|list_dir|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/emit_otel.py post-tool-use --operation file-operation",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "grep_search|search_web|read_url_content",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/emit_otel.py post-tool-use --operation search-operation",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "run_command|manage_task|schedule|list_permissions|ask_permission",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/emit_otel.py post-tool-use --operation execution-operation",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "invoke_subagent|define_subagent|send_message|manage_subagents",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/emit_otel.py post-tool-use --operation agent-collaboration",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "ask_question|generate_image",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/emit_otel.py post-tool-use --operation interaction-operation",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
