{
  "description": "Privacy-safe Codex lifecycle traces; metadata-only is the default and reads no content.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/examples/codex-hooks/codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "commandWindows": "\"C:\\ABSOLUTE\\PATH\\TO\\python.exe\" \"C:\\ABSOLUTE\\PATH\\TO\\codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/examples/codex-hooks/codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "commandWindows": "\"C:\\ABSOLUTE\\PATH\\TO\\python.exe\" \"C:\\ABSOLUTE\\PATH\\TO\\codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/examples/codex-hooks/codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "commandWindows": "\"C:\\ABSOLUTE\\PATH\\TO\\python.exe\" \"C:\\ABSOLUTE\\PATH\\TO\\codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/examples/codex-hooks/codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "commandWindows": "\"C:\\ABSOLUTE\\PATH\\TO\\python.exe\" \"C:\\ABSOLUTE\\PATH\\TO\\codex_hooks_otel_exporter.py\" --profile personal-local --capture-mode metadata-only --size-scope user-prompt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
