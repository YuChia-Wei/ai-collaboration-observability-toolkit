        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_estimated_context_tokens_total[$__range])) by (framework_version, task_type)",
          "legendFormat": "版本={{framework_version}} 類型={{task_type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rule 狀態轉換（State transitions）",
      "description": "依 framework_version 與 state 統計 rule lifecycle；loaded 不等同 applied 或 effective。",
