  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "各 Framework 版本的成功 Task",
      "description": "依 framework_version 與 task_type 統計上游明確回報 outcome=success 的 task；不是從 provider span 推測。",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_task_outcome_total{outcome=\"success\"}[$__range])) by (framework_version, task_type)",
          "legendFormat": "版本={{framework_version}} 類型={{task_type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "人工修正比例（Manual correction）",
      "description": "人工修正次數除以 task outcome 次數；只代表已記錄的 framework evidence。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_manual_correction_total[$__range])) by (framework_version) / clamp_min(sum(increase(ai_context_task_outcome_total[$__range])) by (framework_version), 1)",
          "legendFormat": "版本={{framework_version}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "載入的 Context Bytes",
      "description": "依 framework_version 與 task_type 顯示載入內容的 bytes；載入不代表內容實際影響行為。",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_loaded_bytes_total[$__range])) by (framework_version, task_type)",
          "legendFormat": "版本={{framework_version}} 類型={{task_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "估算的 Context Token",
      "description": "依 framework_version 與 task_type 顯示估算 token；不是 provider 帳務 token。",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
