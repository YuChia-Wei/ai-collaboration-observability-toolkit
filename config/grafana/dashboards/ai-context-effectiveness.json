      "id": 1,
      "title": "Successful tasks by framework version",
      "description": "",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_task_outcome_total{outcome=\"success\"}[$__range])) by (framework_version, task_type)",
          "legendFormat": "{{model}}"
        }
      ]
    },
