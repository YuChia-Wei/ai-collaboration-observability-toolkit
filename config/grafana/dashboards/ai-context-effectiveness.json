      "id": 1,
      "title": "Successful tasks by framework version",
      "description": "",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_task_outcome_total{outcome=\"success\"}[$__range]) or increase(codex_conversation_turn_count[$__range]) or max_over_time(codex_conversation_turn_count[$__range])) by (model, service_name)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Manual correction ratio",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(ai_context_manual_correction_total[$__range])) by (model) / clamp_min(sum(increase(ai_context_task_outcome_total[$__range])) by (model), 1)) or (sum(max_over_time(codex_websocket_event_duration_ms_count{success=\"false\"}[$__range])) by (model) / clamp_min(sum(max_over_time(codex_websocket_event_duration_ms_count[$__range])) by (model), 1))",
          "legendFormat": "{{model}}"
        }
      ]
    },
