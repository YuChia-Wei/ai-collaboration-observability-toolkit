  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Workflow duration by stage",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_context_workflow_duration_seconds_bucket[5m])) by (le, stage, task_type)) or (histogram_quantile(0.95, sum(rate(codex_turn_e2e_duration_ms_bucket[5m])) by (le, model)) / 1000) or (histogram_quantile(0.95, sum(rate(codex_turn_e2e_duration_ms_bucket[1h])) by (le, model)) / 1000)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Wait duration by reason",
      "description": "",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_wait_duration_seconds_sum[$__range])) by (reason, stage) or (sum(increase(codex_responses_api_overhead_duration_ms_sum[$__range])) by (model) / 1000) or (sum(max_over_time(codex_responses_api_overhead_duration_ms_sum[$__range])) by (model) / 1000)",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Validation runs",
      "description": "",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_validation_runs_total[$__range])) by (tier, outcome, reused) or sum(increase(codex_guardian_review_duration_ms_count[$__range])) by (model, outcome) or sum(max_over_time(codex_guardian_review_duration_ms_count[$__range])) by (model, outcome)",
          "legendFormat": "{{model}} - {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Duplicate validation ratio",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(ai_context_validation_duplicate_total[$__range])) / clamp_min(sum(increase(ai_context_validation_runs_total[$__range])), 1)) or (sum(increase(codex_websocket_event_duration_ms_count{success=\"false\"}[$__range])) / clamp_min(sum(increase(codex_websocket_event_duration_ms_count[$__range])), 1))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Retries by reason",
      "description": "",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_retry_total[$__range])) by (reason, stage) or sum(increase(codex_remote_models_fetch_update_duration_ms_count[$__range])) by (model, service_name) or sum(max_over_time(codex_remote_models_fetch_update_duration_ms_count[$__range])) by (model, service_name)",
          "legendFormat": "{{model}}"
        }
      ]
    }
