{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "各階段 Workflow 耗時 P95",
      "description": "依 stage 與 task_type 顯示 ai_context workflow 耗時；只有上游送出 framework evidence 時才有資料。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ai_context_workflow_duration_seconds_bucket[$__rate_interval])) by (le, stage, task_type))",
          "legendFormat": "階段={{stage}} 類型={{task_type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "各原因等待時間（Wait duration）",
      "description": "依 reason 與 stage 彙總有明確歸因的等待時間；沒有資料不代表沒有等待。",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_wait_duration_seconds_sum[$__range])) by (reason, stage)",
          "legendFormat": "原因={{reason}} 階段={{stage}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "驗證執行次數（Validation runs）",
      "description": "依 tier、outcome 與 reused 統計驗證執行證據；不得把 skipped 或 blocked 解讀為 passed。",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_validation_runs_total[$__range])) by (tier, outcome, reused)",
          "legendFormat": "層級={{tier}} 結果={{outcome}} 重用={{reused}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "重複驗證比例（Duplicate ratio）",
      "description": "重複 validation 次數除以所有 validation runs；需搭配 fingerprint invalidation 語意判讀。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_validation_duplicate_total[$__range])) / clamp_min(sum(increase(ai_context_validation_runs_total[$__range])), 1)",
          "legendFormat": "重複比例"
        }
      ]
    },
    {
      "id": 5,
      "title": "各原因重試次數（Retries）",
      "description": "依 reason 與 stage 顯示明確記錄的 retry；重複 span 本身不等同 retry。",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_context_retry_total[$__range])) by (reason, stage)",
          "legendFormat": "原因={{reason}} 階段={{stage}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": [
    "ai-collaboration",
    "opentelemetry"
  ],
  "templating": {
    "list": []
  },
