        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ai_agent_token_usage_total{ai_agent_provider=\"openai\",ai_agent_product=\"codex\",model_id=~\"$model\",accounting_schema=\"v3\",service_namespace!~\"^ai-collaboration(-cost|-role)?-fixture$\"})",
          "legendFormat": "Token"
        }
      ]
    },
    {
