      "id": 1,
      "title": "Token usage by model and type",
      "description": "Native Codex token histogram sums. This is provider telemetry, not billing.",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "sum(increase(codex_turn_token_usage_sum[$__range])) by (model, token_type)", "legendFormat": "{{model}} - {{token_type}}"}
      ]
    },
    {
      "id": 2,
      "title": "P95 turn duration",
      "description": "Native Codex end-to-end turn duration.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(codex_turn_e2e_duration_ms_bucket[$__rate_interval])) by (le, model))", "legendFormat": "{{model}}"}
