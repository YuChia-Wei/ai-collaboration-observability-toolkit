    {
      "id": 900,
      "title": "V3 估算樣本覆蓋率",
      "description": "各已觀測 token series 的 rule／rate 積分樣本數 × 30 秒／所選秒數之平均。最後一次 Collector scrape up=0 或不存在時不產生樣本；新 series、warmup、缺 rule samples 會降低比例。這不是 native producer 新鮮度、實際 scrape 完整率或帳務完整性；沒有資料保持缺失。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(avg(count_over_time(ai_agent_accounting_sample_available{ai_agent_provider=\"openai\",ai_agent_product=\"codex\",model_id=~\"$model\",accounting_schema=\"v3\",service_namespace!~\"^ai-collaboration(-cost|-role)?-fixture$\"}[$__range])) * 30 / $__range_s, 1)",
          "instant": true,
          "range": false
        }
      ]
    },
