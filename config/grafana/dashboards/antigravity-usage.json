    {
      "id": 7,
      "title": "Lifecycle metadata events",
      "description": "Metadata-only hook and status-line logs. Raw prompt, paths, e-mail, tool arguments/output, and transcript content are not emitted by the example.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"antigravity(-cli|-2)?\"}",
          "queryType": "range"
        }
      ]
