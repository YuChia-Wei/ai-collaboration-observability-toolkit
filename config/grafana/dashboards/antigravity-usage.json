  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "觀測到的 Session Token（非帳務）",
      "description": "Antigravity CLI status line 的 token 總量；不是官方 credit 或發票資料。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (token_type, model_family) (antigravity_session_tokens{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "{{model_family}} / {{token_type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "目前 Context 組成（Composition）",
      "description": "傳給自訂 status-line command 的目前 context window 欄位。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (token_type, model_family) (antigravity_context_tokens{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "{{model_family}} / {{token_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Context Window 使用率",
      "description": "Antigravity CLI status payload 回報的 context window 使用比例。",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max(antigravity_context_used_ratio{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "已使用"
        }
      ]
    },
    {
      "id": 4,
      "title": "剩餘 Quota（觀測值）",
      "description": "Status line 可見的 quota 比例；不是帳務 ledger。",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (type) (antigravity_quota_remaining_ratio{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "背景 Task（Background tasks）",
      "description": "Antigravity CLI status payload 回報的執行中背景 task 數量。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(antigravity_background_task_count{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "Tasks"
        },
        {
          "refId": "B",
          "expr": "max(antigravity_artifact_count{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "Artifacts"
        }
      ]
    },
    {
      "id": 6,
      "title": "Context 是否超過 200k",
      "description": "CLI status payload 的布林觀測值；1 代表是，0 代表否。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "否"},
                "1": {"text": "是"}
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(antigravity_context_exceeds_200k{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "超過 200k"
        }
      ]
    },
    {
      "id": 7,
      "title": "Lifecycle Metadata 事件",
      "description": "只含 metadata 的 hook 與 status-line logs。範例不送出原始 prompt、路徑、電子郵件、工具參數／輸出或逐字內容。",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"antigravity(-cli|-2)?\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 8,
      "title": "等待使用者輸入（Pending input）",
      "description": "觀測到的 CLI pending-input 狀態；這是 workflow-state metadata，不是帳務資料。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(antigravity_pending_input_count{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "等待輸入",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "等待工具確認（Tool confirmation）",
      "description": "CLI status payload 的布林觀測值；1 代表正在等待確認。",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 15,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "mappings": [
            {
              "type": "value",
