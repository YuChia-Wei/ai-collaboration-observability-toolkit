  "panels": [
    {
      "id": 1,
      "title": "Observed session tokens (not billing)",
      "description": "Antigravity CLI status-line totals. These are not official credits or invoice data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (token_type, model_family) (antigravity_session_tokens{tool=\"antigravity\"})",
          "legendFormat": "{{model_family}} / {{token_type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Current context composition",
      "description": "Current context-window fields reported to the custom status-line command.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (token_type, model_family) (antigravity_context_tokens{tool=\"antigravity\"})",
          "legendFormat": "{{model_family}} / {{token_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Context window used",
      "description": "Ratio reported by the Antigravity CLI status payload.",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max(antigravity_context_used_ratio{tool=\"antigravity\"})",
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 4,
      "title": "Quota remaining (observed)",
      "description": "Quota ratios exposed to the status line; not an accounting ledger.",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by (type) (antigravity_quota_remaining_ratio{tool=\"antigravity\"})",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
