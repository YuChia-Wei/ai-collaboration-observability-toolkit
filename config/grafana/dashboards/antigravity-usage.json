      "targets": [
        {
          "refId": "A",
          "expr": "max(antigravity_tool_confirmation_pending{tool=\"antigravity\",service_namespace!~\"^ai-collaboration(-cost)?-fixture$\"})",
          "legendFormat": "等待確認"
