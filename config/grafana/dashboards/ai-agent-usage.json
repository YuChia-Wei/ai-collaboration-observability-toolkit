  "panels": [
    {
      "id": 1,
      "title": "Token usage by provider and type",
      "description": "Canonical provider-reported token histogram sums.",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "sum(increase(ai_agent_turn_token_usage_sum[$__range])) by (ai_agent_provider, ai_agent_product, model_family, token_type)", "legendFormat": "{{ai_agent_product}} {{model_family}} - {{token_type}}"}
      ]
    },
    {
      "id": 2,
      "title": "P95 turn duration",
      "description": "Canonical AI-agent turn latency.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(ai_agent_turn_duration_ms_bucket[$__rate_interval])) by (le, ai_agent_provider, ai_agent_product, model_family))", "legendFormat": "{{ai_agent_product}} {{model_family}}"}
      ]
    },
    {
      "id": 3,
      "title": "Tool calls by bounded category",
      "description": "Canonical tool counter; raw tool names are removed.",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "sum(increase(ai_agent_tool_call[$__range])) by (ai_agent_provider, ai_agent_product, tool_category, success)", "legendFormat": "{{ai_agent_product}} {{tool_category}} success={{success}}"}
      ]
    },
    {
      "id": 4,
      "title": "Observed session tokens",
      "description": "Observed extension gauge, not provider billing.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "max by (ai_agent_provider, ai_agent_product, token_type, model_family) (ai_agent_observed_session_tokens)", "legendFormat": "{{ai_agent_product}} {{model_family}} - {{token_type}}"}
      ]
    },
    {
      "id": 5,
      "title": "Observed context used",
      "description": "Current context gauge supplied by a local extension.",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [
        {"refId": "A", "expr": "max by (ai_agent_provider, ai_agent_product) (ai_agent_observed_context_used_ratio)", "legendFormat": "{{ai_agent_product}}"}
      ]
    },
    {
      "id": 6,
      "title": "Observed quota remaining",
      "description": "Provider-extension observation, not an authoritative billing balance.",
