  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "按 Provider 與類型統計 Token 用量",
      "description": "Provider 回報並正規化為 canonical contract 的 token histogram 總和。",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "sum(increase(ai_agent_turn_token_usage_sum[$__range])) by (ai_agent_provider, ai_agent_product, model_family, token_type)", "legendFormat": "{{ai_agent_product}} {{model_family}} - {{token_type}}"}
      ]
    },
    {
      "id": 2,
      "title": "AI Agent 回合耗時 P95",
      "description": "Canonical AI-agent 回合延遲；P95 代表 95% 的觀測值不超過此數值。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(ai_agent_turn_duration_ms_bucket[$__rate_interval])) by (le, ai_agent_provider, ai_agent_product, model_family))", "legendFormat": "{{ai_agent_product}} {{model_family}}"}
      ]
    },
    {
      "id": 3,
      "title": "按受限分類統計工具呼叫（Tool calls）",
      "description": "Canonical 工具 counter；原始工具名稱已移除，只保留 bounded category。",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "sum(increase(ai_agent_tool_call[$__range])) by (ai_agent_provider, ai_agent_product, tool_category, success)", "legendFormat": "{{ai_agent_product}} {{tool_category}} 成功={{success}}"}
      ]
    },
    {
      "id": 4,
      "title": "觀測到的 Session Token",
      "description": "由 extension 觀測到的 gauge，不是 provider 帳務資料。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "max by (ai_agent_provider, ai_agent_product, token_type, model_family) (ai_agent_observed_session_tokens)", "legendFormat": "{{ai_agent_product}} {{model_family}} - {{token_type}}"}
      ]
    },
    {
      "id": 5,
      "title": "觀測到的 Context 使用率",
      "description": "本機 extension 提供的目前 context 使用率 gauge。",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"], "fields": ""}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [
        {"refId": "A", "expr": "max by (ai_agent_provider, ai_agent_product) (ai_agent_observed_context_used_ratio)", "legendFormat": "{{ai_agent_product}}"}
      ]
    },
    {
      "id": 6,
      "title": "觀測到的剩餘 Quota",
      "description": "Provider extension 的觀測值，不是具權威性的帳務餘額。",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"refId": "A", "expr": "max by (ai_agent_provider, ai_agent_product, type) (ai_agent_observed_quota_remaining_ratio)", "legendFormat": "{{ai_agent_product}} {{type}}"}
      ]
    },
    {
      "id": 7,
      "title": "Canonical 證據類別（Evidence classes）",
      "description": "Canonical AI-agent metric series 的清單；顯示 evidence_class 與來源。",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm"},
      "targets": [
        {"refId": "A", "expr": "count({__name__=~\"ai_agent_.+\"}) by (__name__, ai_agent_provider, ai_agent_product, evidence_class)", "legendFormat": "{{__name__}}", "format": "table", "instant": true}
      ]
    },
    {
      "id": 8,
      "title": "費用不可用（Cost is unavailable）",
      "description": "目前沒有跨 provider 且可驗證的價格 contract。",
      "type": "text",
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 5},
      "options": {"mode": "markdown", "content": "### 費用不可用（Cost unavailable）\n\nCanonical contract 不會從 token 或 request metric 推估貨幣。只有取得明確且有版本的帳務來源後，才能加入費用資料。"}
    }
  ],
