{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-collaboration-observability/session-usage-report.schema.json",
  "title": "Pseudonymous Codex session usage report",
  "description": "Local metadata-only export. HMAC pseudonyms remain linkable under the same shared key. Credit amounts are public-rate equivalents, not actual debits.",
  "type": "object",
  "required": [
    "schema_version",
    "key_id",
    "rate_card_version",
    "rate_card_sha256",
    "estimate_kind",
    "billing_status",
    "scope",
    "sessions",
    "responses",
    "groups",
    "summary",
    "diagnostics",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "session-usage/v1",
        "session-usage/v2"
      ]
    },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "rate_card_version": {
      "type": "string",
      "pattern": "^openai-codex-credits-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "rate_card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimate_kind": {
      "const": "public_codex_credit_equivalent"
    },
    "billing_status": {
      "const": "actual_debit_unavailable"
    },
    "scope": {
      "type": "object",
      "required": [
        "selection",
        "includes_subagents"
      ],
      "properties": {
        "selection": {
          "enum": [
            "all_sessions",
            "single_session",
            "session_with_subagents",
            "merged_reports"
          ]
        },
        "includes_subagents": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "session_count",
        "response_count",
        "tokens",
        "estimated_credits",
        "unpriced_tokens",
        "metadata_complete",
        "pricing_complete"
      ],
      "properties": {
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "response_count": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "estimated_credits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unpriced_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_complete": {
          "type": "boolean"
        },
        "pricing_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "files_scanned",
        "invalid_json_lines",
        "invalid_usage_records",
        "inherited_usage_records_ignored",
        "duplicate_response_records",
        "unsupported_sessions",
        "missing_context_records",
        "unknown_model_records",
        "unknown_effort_records",
        "unknown_tier_records",
        "routing_ambiguous_records",
        "invalid_session_metadata",
        "orphan_parent_sessions",
        "unverified_thread_totals"
      ],
      "properties": {
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_json_lines": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_usage_records": {
          "type": "integer",
          "minimum": 0
        },
        "inherited_usage_records_ignored": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_response_records": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "missing_context_records": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_model_records": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_effort_records": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_tier_records": {
          "type": "integer",
          "minimum": 0
        },
        "routing_ambiguous_records": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_session_metadata": {
          "type": "integer",
          "minimum": 0
        },
        "orphan_parent_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "unverified_thread_totals": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "usage_metrics": {
