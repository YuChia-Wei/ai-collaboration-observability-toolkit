              "source": {
                "enum": [
                  "rollout",
                  "app_server"
                ]
              },
              "scope": {
                "const": "account_quota"
              },
              "observed_in_session_key": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observation_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "thread_estimates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
