{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-collaboration-observability/session-usage-report.schema.json",
  "title": "Pseudonymous Codex session usage report",
  "description": "Local metadata-only export. HMAC pseudonyms remain linkable under the same shared key. Credit amounts are public-rate equivalents, not actual debits.",
  "type": "object",
  "required": [
    "schema_version",
    "key_id",
    "rate_card_version",
    "rate_card_sha256",
    "estimate_kind",
    "billing_status",
    "scope",
    "sessions",
    "responses",
    "groups",
    "summary",
    "diagnostics",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "session-usage/v1"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "rate_card_version": {
      "type": "string",
      "pattern": "^openai-codex-credits-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "rate_card_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "estimate_kind": {
      "const": "public_codex_credit_equivalent"
    },
    "billing_status": {
      "const": "actual_debit_unavailable"
    },
    "scope": {
      "type": "object",
      "required": [
        "selection",
        "includes_subagents"
      ],
      "properties": {
        "selection": {
          "enum": [
            "all_sessions",
            "single_session",
            "session_with_subagents",
            "merged_reports"
          ]
        },
        "includes_subagents": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "session_count",
        "response_count",
        "tokens",
        "estimated_credits",
        "unpriced_tokens",
        "metadata_complete",
        "pricing_complete"
      ],
      "properties": {
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "response_count": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "estimated_credits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unpriced_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "metadata_complete": {
          "type": "boolean"
        },
        "pricing_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "files_scanned",
        "invalid_json_lines",
        "invalid_usage_records",
        "inherited_usage_records_ignored",
        "duplicate_response_records",
        "unsupported_sessions",
        "missing_context_records",
        "unknown_model_records",
        "unknown_effort_records",
        "unknown_tier_records",
        "routing_ambiguous_records",
        "invalid_session_metadata",
        "orphan_parent_sessions",
        "unverified_thread_totals"
      ],
      "properties": {
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_json_lines": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_usage_records": {
          "type": "integer",
          "minimum": 0
        },
        "inherited_usage_records_ignored": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_response_records": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "missing_context_records": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_model_records": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_effort_records": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_tier_records": {
          "type": "integer",
          "minimum": 0
        },
        "routing_ambiguous_records": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_session_metadata": {
          "type": "integer",
          "minimum": 0
        },
        "orphan_parent_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "unverified_thread_totals": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tokens": {
      "type": "object",
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "required": [
        "session_key",
        "parent_session_key",
        "agent_role",
        "status",
        "response_count",
        "tokens",
        "estimated_credits",
        "unpriced_tokens",
        "first_seen",
        "last_seen"
      ],
      "properties": {
        "session_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_session_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_role": {
          "enum": [
            "primary",
            "subagent",
            "approval_reviewer",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "unsupported_source",
            "partial"
          ]
        },
        "response_count": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "anyOf": [
            {
              "$ref": "#/$defs/tokens"
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_credits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unpriced_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "first_seen": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_seen": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "(?:Z|\\+00:00)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "session_key",
        "root_session_key",
        "parent_session_key",
        "turn_key",
        "response_key",
        "timestamp",
        "agent_role",
        "configured_model_id",
        "actual_model_id",
        "model_id",
        "model_basis",
        "reasoning_effort",
        "configured_service_tier",
        "tier_basis",
        "tokens",
        "estimated_credits",
        "unpriced_tokens",
        "pricing_status",
        "credit_multiplier"
      ],
      "properties": {
        "session_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root_session_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_session_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|\\+00:00)$"
        },
        "agent_role": {
          "enum": [
            "primary",
            "subagent",
            "approval_reviewer",
            "unknown"
          ]
        },
        "configured_model_id": {
          "enum": [
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "gpt-6-astra",
            "gpt-6-sol",
            "gpt-6.1-sol",
            "gpt-6-luna",
            "unmapped"
          ]
        },
        "actual_model_id": {
          "const": "unmapped"
        },
        "model_id": {
          "enum": [
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "gpt-6-astra",
            "gpt-6-sol",
            "gpt-6.1-sol",
            "gpt-6-luna",
            "unmapped"
          ]
        },
        "model_basis": {
          "enum": [
            "configured",
            "routing_ambiguous",
            "unknown"
          ]
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra",
            "unknown"
          ]
        },
        "configured_service_tier": {
          "enum": [
            "standard",
            "fast",
            "ultrafast",
            "unknown"
          ]
        },
        "tier_basis": {
          "enum": [
            "configured",
            "standard_assumption"
          ]
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "estimated_credits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unpriced_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "pricing_status": {
          "enum": [
            "priced",
            "partial",
            "unpriced"
          ]
        },
        "credit_multiplier": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": [
        "session_key",
        "root_session_key",
        "agent_role",
        "configured_model_id",
        "actual_model_id",
        "model_id",
        "model_basis",
        "reasoning_effort",
        "configured_service_tier",
        "tier_basis",
        "response_count",
        "tokens",
        "estimated_credits",
        "unpriced_tokens",
        "pricing_status"
      ],
      "properties": {
        "session_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "root_session_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "agent_role": {
          "enum": [
            "primary",
            "subagent",
            "approval_reviewer",
            "unknown"
          ]
        },
        "configured_model_id": {
          "enum": [
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "gpt-6-astra",
            "gpt-6-sol",
            "gpt-6.1-sol",
            "gpt-6-luna",
            "unmapped"
          ]
        },
        "actual_model_id": {
          "const": "unmapped"
        },
        "model_id": {
          "enum": [
            "gpt-5.6-sol",
            "gpt-5.6-terra",
            "gpt-5.6-luna",
            "gpt-6-astra",
            "gpt-6-sol",
            "gpt-6.1-sol",
            "gpt-6-luna",
            "unmapped"
          ]
        },
        "model_basis": {
          "enum": [
            "configured",
            "routing_ambiguous",
            "unknown"
          ]
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra",
            "unknown"
          ]
        },
        "configured_service_tier": {
          "enum": [
            "standard",
            "fast",
            "ultrafast",
            "unknown"
          ]
        },
        "tier_basis": {
          "enum": [
            "configured",
            "standard_assumption"
          ]
        },
        "response_count": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "estimated_credits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unpriced_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "pricing_status": {
          "enum": [
            "priced",
            "partial",
            "unpriced"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
