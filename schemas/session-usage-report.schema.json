                    "properties": {
                      "used_percent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "window_minutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "resets_at": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "secondary": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "used_percent",
                      "window_minutes",
                      "resets_at"
                    ],
                    "properties": {
                      "used_percent": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "window_minutes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2147483647
                      },
                      "resets_at": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9223372036854775807
