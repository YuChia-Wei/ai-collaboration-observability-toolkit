                      "balance": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 128,
                            "pattern": "^\\d+(?:\\.\\d+)?$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "primary": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "used_percent",
                      "window_minutes",
                      "resets_at"
