                          "maximum": 9223372036854775807
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "input_tokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "output_tokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "total_tokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "estimated_usage_credits_micros": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    }
                  }
                }
              },
              "observation_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
